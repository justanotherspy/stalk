# Example configuration for stalk.
#
# Copy this to ~/.stalk.yaml (the default location) or point at it with
# --config /path/to/file.yaml.
#
# Configuration precedence (highest wins):
#   1. command-line flags        (e.g. --log-level debug)
#   2. environment variables     (STALK_ prefix; nested keys use "_",
#                                 e.g. log.level -> STALK_LOG_LEVEL)
#   3. this config file
#   4. built-in defaults

# Enable verbose (debug) logging. Equivalent to --verbose / -v.
# Overrides log.level when true.
verbose: false

log:
  # Minimum level to emit: debug, info, warn, error.
  level: info
  # Output format: text (human-readable) or json (structured).
  format: text

# ---------------------------------------------------------------------------
# Everything below is the stalk daemon's own configuration. The sources are
# examples, so they ship commented out; run `stalk config check` to validate
# whatever you uncomment. The daemon itself lands in a later PR. See
# docs/MVP-SPEC.md section 4 for the authoritative schema.
#
# Durations accept the usual Go units (30s, 5m, 2h) plus whole days: 14d.

# Schema version of this file. Optional; must be 1 when set. Bumped only on a
# breaking config change.
# version: 1

# daemon:
#   # Shut down after this long with no connected sessions and no active
#   # subscriptions. The next client that needs a daemon respawns one.
#   idle_exit_after: 30m
#
#   # When a session's stream disconnects without saying goodbye, keep its
#   # subscriptions polling this long before cancelling them. A reattach within
#   # the window resumes cleanly and flushes whatever was missed.
#   disconnect_grace: 10m
#
#   # Refuse further subscribe calls from a session past this many.
#   max_subscriptions_per_session: 32
#
#   # Drop new connections past this many concurrent clients.
#   max_connections: 64
#
#   retention:
#     events_max_age: 14d
#     events_max_rows: 50000

# Named event sources. The name is what an agent passes to subscribe_event, so
# keep them short and memorable.
#
# `token_var` is the NAME of an environment variable, never a token itself:
# secrets stay out of this file and out of viper entirely. The daemon reads the
# variable at poll time.
#
# Caveat worth knowing: the daemon inherits its environment from whichever
# client auto-spawned it first, which inherited it from Claude Code, which
# inherited it from your login shell. Export these in your shell profile, not
# per-session, or the daemon may not see them.
#
# Source names: a letter or digit first, then letters, digits, - or _.
#
# sources:
#   github-personal:
#     type: github
#     # Unset or empty falls back to the `gh auth` chain, then to
#     # unauthenticated requests (60 req/h, so polls are throttled to 120s).
#     token_var: GITHUB_PERSONAL_TOKEN
#
#   github-work:
#     type: github
#     token_var: GITHUB_WORK_TOKEN
#     # Subscribe targets outside these owners are rejected.
#     allowed_owners: [some-org]
#     # GitHub Enterprise: the REST API root of your instance.
#     # api_url: https://github.example.com/api/v3
#
#   deploy-status:
#     type: http_poll
#     url: https://deploys.internal.example/api/recent.json
#     interval: 30s          # optional (default 30s), minimum 10s
#     items_path: "deploys"  # key holding the array; omit to use the root
#     id_field: "id"         # dedupe field; omit to hash the whole item
#     token_var: DEPLOY_TOKEN
